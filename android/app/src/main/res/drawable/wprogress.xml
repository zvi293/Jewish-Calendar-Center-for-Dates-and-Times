<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="4dp" /><solid android:color="#2EFFFFFF" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:gravity="right" android:clipOrientation="horizontal">
            <shape><corners android:radius="4dp" /><gradient android:angle="0" android:startColor="#FDE68A" android:endColor="#E0B74F" /></shape>
        </clip>
    </item>
</layer-list>
