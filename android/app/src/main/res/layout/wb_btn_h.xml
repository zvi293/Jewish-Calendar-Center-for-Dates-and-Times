<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/btn"
    android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center" android:layoutDirection="rtl"
    android:background="@drawable/wbtn" android:paddingStart="6dp" android:paddingEnd="6dp">
    <ImageView android:id="@+id/ic" android:layout_width="22dp" android:layout_height="22dp" android:importantForAccessibility="no" />
    <FrameLayout android:layout_width="6dp" android:layout_height="1dp" />
    <TextView android:id="@+id/t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="14sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:shadowColor="#73000A28" android:shadowRadius="3" android:shadowDy="1" />
</LinearLayout>
