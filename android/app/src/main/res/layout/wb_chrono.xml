<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/box"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
    android:layoutDirection="rtl" android:background="@drawable/wpill" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="4dp">
    <TextView android:id="@+id/pre" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="12sp" android:includeFontPadding="false" android:text="בעוד" android:shadowColor="#73000A28" android:shadowRadius="3" android:shadowDy="1" />
    <FrameLayout android:layout_width="5dp" android:layout_height="1dp" />
    <Chronometer android:id="@+id/ch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layoutDirection="ltr" android:textDirection="ltr" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="12sp" android:includeFontPadding="false" android:shadowColor="#73000A28" android:shadowRadius="3" android:shadowDy="1" />
</LinearLayout>
