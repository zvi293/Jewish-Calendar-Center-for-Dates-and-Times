<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/row"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
    android:layoutDirection="rtl" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp">
    <TextView android:id="@+id/lbl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:textSize="14sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:shadowColor="#73000A28" android:shadowRadius="3" android:shadowDy="1" />
    <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="5dp" android:fontFamily="sans-serif" android:textColor="#C8FFFFFF" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:shadowColor="#73000A28" android:shadowRadius="3" android:shadowDy="1" />
    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/cdbox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layoutDirection="rtl" android:background="@drawable/wpill_solid" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="3dp" android:visibility="gone">
        <TextView android:id="@+id/cdpre" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="#3D2F0E" android:textSize="11sp" android:includeFontPadding="false" android:text="בעוד " />
        <Chronometer android:id="@+id/cd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layoutDirection="ltr" android:textDirection="ltr" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="#3D2F0E" android:textSize="11sp" android:includeFontPadding="false" />
    </LinearLayout>
    <TextView android:id="@+id/cdtxt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/wpill_solid" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="3dp" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="#3D2F0E" android:textSize="11sp" android:includeFontPadding="false" android:visibility="gone" />
    <TextView android:id="@+id/tag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="6dp" android:paddingEnd="6dp" android:fontFamily="sans-serif" android:textColor="#B3FFFFFF" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:shadowColor="#73000A28" android:shadowRadius="3" android:shadowDy="1" />
    <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layoutDirection="ltr" android:textDirection="ltr" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="15sp" android:includeFontPadding="false" android:fontFeatureSettings="tnum" android:shadowColor="#73000A28" android:shadowRadius="3" android:shadowDy="1" />
</LinearLayout>
